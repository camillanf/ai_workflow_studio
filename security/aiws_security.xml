<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Workflow: users read own company, editors full own company -->
        <record id="aiws_rule_workflow_user" model="ir.rule">
            <field name="name">AIWS Workflow: user read own company</field>
            <field name="model_id" ref="model_aiws_workflow"/>
            <field name="domain_force">[('company_id', 'in', (False, company_id))]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="aiws_rule_workflow_editor" model="ir.rule">
            <field name="name">AIWS Workflow: editor own company</field>
            <field name="model_id" ref="model_aiws_workflow"/>
            <field name="domain_force">[('company_id', 'in', (False, company_id))]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_editor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Node -->
        <record id="aiws_rule_node_user" model="ir.rule">
            <field name="name">AIWS Node: user read own company</field>
            <field name="model_id" ref="model_aiws_node"/>
            <field name="domain_force">[('company_id', 'in', (False, company_id))]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="aiws_rule_node_editor" model="ir.rule">
            <field name="name">AIWS Node: editor own company</field>
            <field name="model_id" ref="model_aiws_node"/>
            <field name="domain_force">[('company_id', 'in', (False, company_id))]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_editor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Connection -->
        <record id="aiws_rule_connection_user" model="ir.rule">
            <field name="name">AIWS Connection: user read own company</field>
            <field name="model_id" ref="model_aiws_connection"/>
            <field name="domain_force">[('company_id', 'in', (False, company_id))]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="aiws_rule_connection_editor" model="ir.rule">
            <field name="name">AIWS Connection: editor own company</field>
            <field name="model_id" ref="model_aiws_connection"/>
            <field name="domain_force">[('company_id', 'in', (False, company_id))]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_editor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Execution: users/editor read own workflows' executions -->
        <record id="aiws_rule_execution_user" model="ir.rule">
            <field name="name">AIWS Execution: read own workflows</field>
            <field name="model_id" ref="model_aiws_execution"/>
            <field name="domain_force">[("workflow_id.create_uid", "=", uid)]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_user')), (4, ref('ai_workflow_studio.aiws_group_editor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Execution Log: users/editor read own workflows' execution logs -->
        <record id="aiws_rule_execution_log_user" model="ir.rule">
            <field name="name">AIWS Execution Log: read own workflows</field>
            <field name="model_id" ref="model_aiws_execution_log"/>
            <field name="domain_force">[("execution_id.workflow_id.create_uid", "=", uid)]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_user')), (4, ref('ai_workflow_studio.aiws_group_editor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- AI Provider: administrators only -->
        <record id="aiws_rule_ai_provider_admin" model="ir.rule">
            <field name="name">AIWS AI Provider: admin own company</field>
            <field name="model_id" ref="model_aiws_ai_provider"/>
            <field name="domain_force">[('company_id', 'in', (False, company_id))]</field>
            <field name="groups" eval="[(4, ref('ai_workflow_studio.aiws_group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
