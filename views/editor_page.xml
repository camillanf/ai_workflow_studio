<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="aiws_editor_page" name="AIWS Editor Page">
        <html>
            <head>
                <title>AIWS Editor</title>
                <meta name="csrf_token" t-att-content="request.csrf_token(None)"/>
                <script type="text/javascript">
                    window.odoo = {
                        csrf_token: "<t t-esc="request.csrf_token(None)"/>",
                        debug: "<t t-esc="debug"/>",
                        __session_info__: <t t-esc="json.dumps(session_info)"/>,
                    };
                </script>
                <script type="text/javascript" src="/aiws/static/owl.js"></script>
                <script type="text/javascript" src="/aiws/static/editor_standalone.js"></script>
            </head>
            <body>
                <div id="aiws-editor-root" t-att-data-workflow-id="workflow_id"/>
            </body>
        </html>
    </template>
</odoo>
